# Project root: only version project sources, documentation, and fixtures.
/*
!/.gitignore
!/README.md
!/CMakeLists.txt
!/main/
!/components/
!/tests/
!/docs/
!/assets/
!/scores/

# Audio and score fixtures (keep other local assets out of Git).
/assets/*
!/assets/*.mp3
!/assets/*.wav
!/assets/*.png
!/assets/README.md

# Generated files and caches, including those in vendor examples.
build/
__pycache__/
*.py[cod]
*.gch
*.uf2
*.o
*.a
*.elf
*.bin
*.log
*.tmp
.DS_Store
